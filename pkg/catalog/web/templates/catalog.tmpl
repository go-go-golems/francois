{{define "content"}}<main>
<section class="hero"><h1>Applications <span class="muted">— each runs on its own origin, with its own database, rooms and model calls.</span></h1></section>
<section class="controls">
<div class="views"><span class="result-count">{{len .Body.Cards}} {{if eq (len .Body.Cards) 1}}application{{else}}applications{{end}}</span>{{if .Body.Tag}}<a class="u" href="/apps">Show all</a>{{end}}</div>
{{if .Body.Tags}}<div class="tags" role="group" aria-label="Filter by tag">
{{range .Body.Tags}}<a class="tag" href="/apps?tag={{.Name}}"{{if .Current}} aria-pressed="true"{{end}}><span class="tag-label">{{.Name}}</span> <span class="tag-count">{{.Count}}</span></a>
{{end}}</div>{{end}}
</section>
{{if .Body.Cards}}{{template "cards" .Body.Cards}}{{else}}<p class="empty">No applications{{if .Body.Tag}} tagged {{.Body.Tag}}{{end}} yet.</p>{{end}}
</main>{{end}}
