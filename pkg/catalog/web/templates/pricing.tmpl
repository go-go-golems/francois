{{define "content"}}{{with .Body}}<main class="sheet">
<h1>Support.</h1><p>Support helps keep the applications available.</p>
{{if .Current}}<p>Your subscription: {{.Current}}.{{if .Paid}} <a class="u" href="/account">Manage subscription</a>.{{end}}</p>{{end}}
{{range .Plans}}{{if or .Current .Prices}}<section class="line"><h2>{{.Name}}</h2><div data-checkout data-plan="{{.Key}}">
{{if .Current}}<span>Current plan</span>{{else}}{{range .Prices}}<a class="tlink" href="/auth/login?return=/pricing" data-interval="{{.Interval}}">{{if .Label}}{{.Label}}{{else}}Support ({{.Interval}}){{end}}</a>{{end}}{{end}}
</div></section>{{end}}{{end}}
</main>{{end}}{{end}}
