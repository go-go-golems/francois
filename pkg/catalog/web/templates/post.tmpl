{{define "content"}}{{with .Body}}<main>
<section class="intro">
<h1>{{period .Post.Title}}</h1>
{{if .Post.Summary}}<p class="sub">{{.Post.Summary}}</p>{{end}}
<p class="byline">{{if .Author}}<a class="u" href="/creators/{{.Author.Slug}}">{{.Author.Name}}</a> · {{end}}{{if .Post.PublishedAt}}{{date .Post.PublishedAt}}{{else}}not published{{end}}{{if .Post.Tags}} · {{join .Post.Tags " · "}}{{end}}</p>
</section>
{{if .Cover}}<figure class="cover">{{template "hero" .Cover}}</figure>{{end}}
<article class="md">{{.Body}}</article>
<p class="lead-actions"><a class="u" href="/journal">All posts</a></p>
</main>{{end}}{{end}}

