{{define "content"}}{{with .Body}}
<main class="final-signin">
<section class="final-section"><div class="final-label">Sign in</div><div class="final-content signin-content">
{{if eq .State "sent"}}
<h1>Check your email.</h1><p>If we can use that address, we’ll send you a link to continue.</p><p>Open the link in this browser within fifteen minutes, then press Continue. You can ignore the email if you didn’t request it.</p><a class="u" href="/signin">Request another link →</a>
{{else if eq .State "confirm"}}
<h1>Ready to sign in?</h1><p>Continue to sign in to your account.</p><form method="post" action="/auth/email/verify"><input type="hidden" name="csrf" value="{{.CSRF}}"><input type="hidden" name="flow" value="{{.Flow}}"><input type="hidden" name="code" value="{{.Code}}"><button class="site-button" type="submit">Continue →</button></form>
{{else if eq .State "error"}}
<h1>Sign-in didn’t complete.</h1><p role="alert">{{.Message}}</p><a class="u" href="/signin">Request a new link →</a>
{{else}}
<h1>Sign in.</h1>
{{if or .Google .GitHub}}
<div class="signin-social">
{{if .Google}}<a class="site-button" href="/auth/login?provider=google&amp;return={{.Return}}">Continue with Google →</a>{{end}}
{{if .GitHub}}<a class="site-button" href="/auth/login?provider=github&amp;return={{.Return}}">Continue with GitHub →</a>{{end}}
</div>
{{if .Available}}<p class="signin-divider small muted">Or use your email</p>{{end}}
{{end}}
{{if .Available}}
<p class="signin-intro">Enter your email and we’ll send you a sign-in link. No password needed.</p>
<form method="post" action="/auth/email/request" class="signin-form"><input type="hidden" name="csrf" value="{{.CSRF}}"><input type="hidden" name="return" value="{{.Return}}"><label for="signin-email">Email</label><input id="signin-email" name="email" type="email" autocomplete="email" maxlength="200" placeholder="you@example.com" required>{{if .Message}}<p role="alert">{{.Message}}</p>{{end}}<button class="site-button" type="submit">Send link →</button></form>
<p class="small muted">Open the link in the same browser within fifteen minutes.</p>
{{else}}<p>Email sign-in is temporarily unavailable.</p>{{end}}
{{if .Signup}}<p class="small muted">New here? Continue with any method above to create an account.</p>{{end}}
{{if .OIDC}}<p class="signin-other"><a class="u" href="/auth/login?return={{.Return}}">More sign-in options →</a></p>{{end}}
{{end}}
</div></section></main>
{{end}}{{end}}
