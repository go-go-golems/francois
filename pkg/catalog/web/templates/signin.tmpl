{{define "content"}}{{with .Body}}<main class="final-signin">
<section class="final-section"><div class="final-label">Sign in</div><div class="final-content signin-content">
{{if eq .State "sent"}}<h1>Check your email.</h1><p>If that address belongs to a supporter account, we’ll send you a sign-in link.</p><p>Open the link in this browser within five minutes, then press Continue. You can ignore the email if you didn’t request it.</p><a class="u" href="/signin">Request another link →</a>
{{else if eq .State "confirm"}}<h1>Ready to sign in?</h1><p>Continue to sign in to your supporter account.</p><form method="post" action="/auth/email/verify"><input type="hidden" name="csrf" value="{{.CSRF}}"><input type="hidden" name="flow" value="{{.Flow}}"><input type="hidden" name="code" value="{{.Code}}"><button class="site-button" type="submit">Continue →</button></form>
{{else if eq .State "error"}}<h1>Sign-in didn’t complete.</h1><p role="alert">{{.Message}}</p><a class="u" href="/signin">Request a new link →</a>
{{else}}<h1>Welcome back.</h1>{{if .Available}}<p>For supporters. Enter your email and we’ll send you a sign-in link. No password needed.</p><form method="post" action="/auth/email/request" class="signin-form"><input type="hidden" name="csrf" value="{{.CSRF}}"><input type="hidden" name="return" value="{{.Return}}"><label for="signin-email">Email address</label><input id="signin-email" name="email" type="email" autocomplete="email" maxlength="254" placeholder="you@example.com" required>{{if .Message}}<p role="alert">{{.Message}}</p>{{end}}<button class="site-button" type="submit">Send link →</button></form><p class="small muted">Open the link in the same browser. It expires after five minutes.</p>{{else}}<p>Email sign-in is temporarily unavailable.</p>{{end}}{{end}}
{{if .Staff}}<p class="signin-staff"><a class="u" href="/auth/login">{{if .Available}}Creator / administrator sign-in{{else}}Continue to sign in{{end}} →</a></p>{{end}}
</div></section></main>{{end}}{{end}}
