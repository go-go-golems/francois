{{define "layout"}}<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>{{if .Title}}{{.Title}} · {{end}}{{.Brand}}</title>
{{if .Description}}<meta name="description" content="{{.Description}}">{{end}}
<meta property="og:site_name" content="{{.Brand}}">
<meta property="og:title" content="{{if .Title}}{{.Title}}{{else}}{{.Brand}}{{end}}">
{{if .Description}}<meta property="og:description" content="{{.Description}}">{{end}}
<meta property="og:url" content="{{.Canonical}}">
{{if .Image}}<meta property="og:image" content="{{.Image}}"><meta name="twitter:card" content="summary_large_image">{{end}}
<link rel="canonical" href="{{.Canonical}}">
<link rel="icon" href="{{asset "icon.svg"}}">
<link rel="alternate" type="application/rss+xml" title="{{.Brand}}" href="/feed.xml">
<link rel="stylesheet" href="/fonts/fonts.css">
<link rel="stylesheet" href="{{asset "catalog.css"}}">
{{if not .Sensitive}}<script src="{{asset "public.js"}}" defer></script>{{end}}
</head>
<body class="final-site">
<header class="site-header page">
<a class="site-wordmark" href="/">{{.Brand}}</a>
<p class="site-statement">A lab for computation and intelligence as material and medium. Run by Manuel and Ramon.</p>
<nav class="site-nav" aria-label="Main navigation">
{{if .User}}<a href="/account">Account</a>{{else if .LoginAvailable}}<a href="{{.LoginHref}}">Sign in</a>{{end}}
{{if .Supporter}}<span class="support-thanks">Thank you for supporting the lab</span>{{else}}<a class="site-support" href="/pricing"><span class="support-desktop">Support the lab</span><span class="support-mobile">Support</span></a>{{end}}
</nav>
</header>
<div class="page">
{{if .JournalPreview}}<p class="notice draft-banner">Journal preview — the blog is hidden from visitors.</p>{{else if .Draft}}<p class="notice draft-banner">Draft preview — visitors see the published page.</p>{{end}}
{{template "content" .}}
<footer class="site-footer">
<div class="footer-brand"><a class="site-wordmark" href="/">{{.Brand}}</a><a href="mailto:hej@slop.boutique">hej@slop.boutique</a></div>
<div><span>For humans</span><a href="/feed.xml">RSS</a>{{if .JournalEnabled}}<a href="/journal">Journal</a>{{end}}{{if not .Supporter}}<a href="/pricing">Support the lab</a>{{end}}{{if .User}}{{range .Nav}}{{if ne .Href "/"}}<a href="{{.Href}}">{{.Label}}</a>{{end}}{{end}}<button class="tlink quiet" type="button" data-signout>Sign out</button>{{end}}</div>
<div><span>Information</span><a href="/privacy">Privacy</a><a href="/terms">Terms</a></div>
<div class="footer-type"><span>Type</span>{{if .TypeCredit}}<p>Set in <a href="https://abcdinamo.com/free/areal">ABC Areal</a>, by <a href="https://abcdinamo.com">ABC Dinamo</a></p>{{end}}</div>
</footer>
</div>
</body>
</html>{{end}}

{{define "cards"}}<section class="rows" aria-label="Applications">
{{range .}}<article class="ri">
<a class="ri-thumb" href="/apps/{{.ID}}" tabindex="-1">{{if .Cover}}{{template "thumb" .Cover}}{{else}}<div class="mono-thumb" aria-hidden="true"><span class="mono-letters">{{monogram .Title}}</span><span class="mono-caps">{{join .Capabilities " · "}}</span></div>{{end}}</a>
<div class="ri-text">
<div class="ri-head">
<h2 class="ri-title"><a href="/apps/{{.ID}}">{{.Title}}</a></h2>
<p class="ri-desc">{{if .Description}}{{.Description}}{{else}}An HTML application.{{end}}</p>
</div>
<div class="ri-foot">
{{if .Creators}}<p class="ri-tags">by {{range $i, $c := .Creators}}{{if $i}}, {{end}}<a class="u" href="/creators/{{$c.Slug}}">{{$c.Name}}</a>{{end}}</p>{{end}}
<p class="ri-tags">{{if .Tags}}{{join .Tags " · "}}{{else}}untagged{{end}}</p>
<p class="ri-actions"><a class="tlink" href="/apps/{{.ID}}">Details</a><span class="ri-path mono">v{{.Version}} · {{date .Published}}</span></p>
</div>
</div>
</article>
{{end}}</section>{{end}}

{{define "posts"}}<section class="lines post-list">
{{range .}}<article class="line">
<div><strong class="post-date">{{date .PublishedAt}}</strong></div>
<div class="release-body">
<h2 class="post-title"><a href="/journal/{{.Slug}}">{{.Title}}</a></h2>
{{if .Summary}}<p class="muted">{{.Summary}}</p>{{end}}
</div>
</article>
{{end}}</section>{{end}}

{{define "media"}}{{if isVideo .MediaType}}<video src="/media/{{.ID}}" controls preload="metadata" playsinline{{if .Poster}} poster="/media/{{.Poster}}"{{end}} aria-label="{{.Alt}}"{{if .Width}} width="{{.Width}}" height="{{.Height}}"{{end}}></video>{{else}}<img src="/media/{{.ID}}" alt="{{.Alt}}" loading="lazy"{{if .Width}} width="{{.Width}}" height="{{.Height}}"{{end}}>{{end}}{{end}}

{{/* A cover: videos loop silently (public.js pauses them for reduced motion). */}}
{{define "hero"}}{{if isVideo .MediaType}}<video src="/media/{{.ID}}" autoplay muted loop playsinline controls preload="auto"{{if .Poster}} poster="/media/{{.Poster}}"{{end}} aria-label="{{.Alt}}"></video>{{else}}<img src="/media/{{.ID}}" alt="{{.Alt}}" loading="eager" fetchpriority="high"{{if .Width}} width="{{.Width}}" height="{{.Height}}"{{end}}>{{end}}{{end}}

{{/* A card thumbnail: a video shows its poster, or its first frame. */}}
{{define "thumb"}}{{if and (isVideo .MediaType) .Poster}}<img src="/media/{{.Poster}}" alt="{{.Alt}}" loading="lazy">{{else if isVideo .MediaType}}<video src="/media/{{.ID}}" muted playsinline preload="metadata" aria-label="{{.Alt}}"></video>{{else}}<img src="/media/{{.ID}}" alt="{{.Alt}}" loading="lazy">{{end}}{{end}}

{{define "support-callout"}}{{if not .Supporter}}<aside class="support-callout" aria-labelledby="support-heading">
<p class="callout-label">Support the lab</p><div><h2 id="support-heading">Keep the lab running.</h2><p>We prototype and explore, and share the work here. The lab is funded by people who want it to keep going. No ads, no clients, no investors.</p><a class="site-button callout-button" href="/pricing">Support the lab →</a><a class="u callout-contact" href="mailto:hej@slop.boutique">Or get in touch</a></div>
</aside>{{end}}{{end}}
