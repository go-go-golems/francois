{{define "content"}}<main aria-label="Applications and writing">
{{if .Body.LoginError}}<p class="notice bad login-error"><span>Sign-in did not complete. Please try again.</span>{{if .LoginAvailable}}<a class="tlink" href="{{.LoginHref}}">Sign in</a>{{end}}</p>{{end}}
<section class="controls">
<div class="views"><a class="u" href="/feed.xml">RSS</a>{{if .Body.Tag}}<a class="u" href="/">Show all</a>{{end}}</div>
{{if .Body.Tags}}<div class="tags" role="group" aria-label="Filter by tag">{{range .Body.Tags}}<a class="tag" href="/?tag={{.Name}}"{{if .Current}} aria-pressed="true"{{end}}>{{.Name}} <span class="tag-count">{{.Count}}</span></a>{{end}}</div>{{end}}
</section>
{{range .Body.Entries}}{{if .Cards}}{{template "cards" .Cards}}{{else}}{{template "posts" .Posts}}{{end}}{{else}}<p class="empty">Nothing published yet.</p>{{end}}
</main>{{end}}
