#!/usr/bin/env bash
# Starts the catalog with provisioned IDs and optional Stripe/Pi settings.
set -euo pipefail
PI_DIR=/etc/francois/pi
if [[ ${BACKEND:-fake} == pi ]]; then
  # Copy only provider configuration into a private, writable operator
  # directory (Pi takes locks and refreshes OAuth tokens there). Sessions,
  # extensions and skills from the source directory are never loaded.
  PI_DIR=/var/lib/francois/pi
  install -d -m 0700 "$PI_DIR"
  for f in auth.json models.json models-store.json settings.json; do
    [[ -f /etc/francois/pi/$f ]] && install -m 0600 "/etc/francois/pi/$f" "$PI_DIR/$f"
  done
fi
args=(catalog serve --listen 127.0.0.1:8090 --public-url "$PUBLIC_URL" --app-domain "$APP_DOMAIN" --signup-allowed
  --database-url "$DATABASE_URL" --release-dir /var/lib/francois/releases --worker-dir /var/lib/francois/worker
  --oidc-issuer "$ISSUER" --oidc-client-id-file /bootstrap/oidc-client-id
  --backend "$BACKEND" --grant-ttl "${GRANT_TTL:-30m}" --pi-agent-dir "$PI_DIR" --worker /app/worker/dist/main.js)
if [[ -n ${STRIPE_PRICE_ID:-} ]]; then
  # The stripe profile writes its listener secret shortly after starting.
  for _ in $(seq 1 30); do [[ -s /bootstrap/stripe-webhook-secret ]] && break; sleep 1; done
fi
if [[ -s /bootstrap/stripe-secret-key && -s /bootstrap/stripe-webhook-secret && -n ${STRIPE_PRICE_ID:-} ]]; then
  args+=(--stripe-secret-key-file /bootstrap/stripe-secret-key --stripe-webhook-secret-files /bootstrap/stripe-webhook-secret)
  # Prices belong to plans in the settings document, not to a flag.
  echo "Stripe sandbox billing enabled; list $STRIPE_PRICE_ID in a plan (Admin → Settings → Plans) to sell it"
else
  echo "Stripe billing disabled (start the 'stripe' profile and set STRIPE_PRICE_ID to enable)"
fi
exec francois "${args[@]}"
