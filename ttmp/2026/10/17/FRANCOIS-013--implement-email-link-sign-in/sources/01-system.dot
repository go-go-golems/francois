digraph G {
      rankdir=TB;
      node [shape=box, style=rounded, fontname="DejaVu Sans", fontsize=13];
      edge [fontname="DejaVu Sans", fontsize=11];
      browser [label="Subscriber browser
Final email form + binding cookie"];
      go [label="Existing Go service
Request / confirmation handlers"];
      db [label="Existing PostgreSQL
Users + sessions + one pending-link table"];
      smtp [label="Configured SMTP relay
One bounded submission"];
      mail [label="Subscriber mailbox
10-minute single-use link"];
      browser -> go; go -> db;
      go -> smtp -> mail;
      mail -> browser [label="Open in requesting browser"];
    }