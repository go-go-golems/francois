digraph access {
 graph [rankdir=TB, bgcolor="white", pad="0.25", nodesep="0.25", ranksep="0.4", dpi=180];
 node [shape=box, style="rounded,filled", fillcolor="#f7f7f7", color="#444444", fontname="DejaVu Sans", fontsize=12, margin="0.14,0.11"];
 edge [color="#555555", arrowsize=0.7];
 html [label="Hosted HTML JavaScript\nor browser agent eval"];
 model [label="Any hosted model call"];
 facade [label="window.slop_boutique\nAuthenticated view RPC"];
 tools [label="Reserved server\ncatalog tools"];
 auth [label="Current principal and membership checks",fillcolor="#eaf0ff"];
 shared [label="Shared catalog read service",fillcolor="#eaf0ff"];
 metadata [label="Published public\ncontent projections",fillcolor="#eef7ee"];
 policy [label="Current download entitlement"];
 source [label="Bounded source text",fillcolor="#eef7ee"];
 {rank=same;html;model;}
 {rank=same;facade;tools;}
 html -> facade; model -> tools; facade -> auth; tools -> auth; auth -> shared;
 shared -> metadata; shared -> policy; policy -> source;
}
